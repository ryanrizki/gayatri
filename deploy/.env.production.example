# Copy to deploy/.env.production on the VPS, then fill real values.
# Never commit the real file.

# --- Postgres (lives on the same VPS) ---
POSTGRES_USER=gayatri
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=gayatri

# --- Domains ---
# API domain — point an A record at the VPS IP. Caddy auto-issues SSL for this.
#   Custom domain: API_DOMAIN=api.gayatri.example.com
#   No-domain quick deploy: API_DOMAIN=<dashed-vps-ip>.sslip.io   (e.g. 43-157-205-51.sslip.io)
API_DOMAIN=api.gayatri.example.com
# Web + admin URLs (Vercel). Used for CORS + WA template links.
# On the free tier these can be the auto-assigned *.vercel.app URLs.
APP_URL_WEB=https://gayatri.example.com
APP_URL_ADMIN=https://admin.gayatri.example.com
CORS_ORIGINS=https://gayatri.example.com,https://admin.gayatri.example.com

# --- Secrets — generate with: openssl rand -hex 48 ---
ADMIN_SESSION_SECRET=CHANGE_ME_96_HEX_CHARS
JWT_SECRET=CHANGE_ME_DIFFERENT_96_HEX_CHARS
INTERNAL_SECRET=CHANGE_ME_RANDOM_STRING

# --- WhatsApp (in-process Baileys, paired from admin /wa/connect) ---
ADMIN_WA_NUMBER=628xxxxxxxxxx
