# --- Database ---
DATABASE_URL="postgresql://gayatri:gayatri@localhost:5432/gayatri?schema=public"

# --- API ---
API_PORT=4000
API_URL="http://localhost:4000"

# --- Web (customer FE) ---
WEB_PORT=3000
APP_URL_WEB="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000"

# --- Admin FE ---
ADMIN_PORT=3001
APP_URL_ADMIN="http://localhost:3001"

# --- Auth ---
ADMIN_SESSION_SECRET="change-me-long-random-string"
JWT_SECRET="change-me-long-random-string"

# --- WhatsApp ---
# openwa = local bridge (scripts/wa-openwa-bridge.mjs, Baileys, real free WA)
#          OR scripts/wa-stub.mjs (fake, no real send) — same REST contract.
# fonnte = hosted REST API, needs a real DEVICE token (not account token).
WA_PROVIDER=openwa
FONNTE_TOKEN=""
# Receives admin notifications (T-ADM-*). Intl format: 62 + 8–14 digits, no 0/+.
# Editable from admin /settings (key: admin_wa_number) — DB row wins over this fallback.
ADMIN_WA_NUMBER="6282xxxxxxxxx"
# Required for POST /v1/internal/tick. Any non-empty string. Generate with scripts/secret.sh.
INTERNAL_SECRET=change-me-long-random-string
# In-process cron drains WaLog + scans reminders every 30s. Set "false" when using
# an external scheduler (cron-job.org) hitting /v1/internal/tick — avoids double-fire.
INTERNAL_CRON_ENABLED=true
# OpenWA bridge / stub endpoint:
OPENWA_URL=http://localhost:9099
OPENWA_API_KEY=local-test
OPENWA_SEND_PATH=/api/messages/send
OPENWA_API_KEY_HEADER=X-Api-Key

# --- File storage (Supabase) ---
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_KEY=""
SUPABASE_BUCKET="gayatri-uploads"

# --- Monitoring ---
SENTRY_DSN=""

# --- Misc ---
TZ="Asia/Jakarta"
NODE_ENV="development"
