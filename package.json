{
  "name": "gayatri",
  "version": "0.1.0",
  "private": true,
  "description": "Gayatri baby spa platform — monorepo root",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @gayatri/db prisma generate",
    "db:migrate": "pnpm --filter @gayatri/db prisma migrate dev",
    "db:seed": "pnpm --filter @gayatri/db seed",
    "db:create-admin": "pnpm --filter @gayatri/db create-admin",
    "db:studio": "pnpm --filter @gayatri/db prisma studio"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.5.4",
    "prettier": "^3.3.3"
  },
  "engines": {
    "node": ">=20"
  }
}
